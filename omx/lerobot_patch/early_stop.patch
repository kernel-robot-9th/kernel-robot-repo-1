+def _couping_early_stop():
+    """[couping] 정책 실행 중 조건이 처음 맞으면 N초 뒤 에피소드를 끝낸다. 환경변수가 없으면 아무것도 안 함.
+
+    COUPING_EARLY_STOP="left_gripper.pos>=90:2"     → 왼쪽 그리퍼 값이 90 이상이 되면 2초 뒤 종료
+    COUPING_EARLY_STOP="left_gripper.pos>=55:2@10"  → 시작 10초 동안은 조건을 보지 않음
