+    값은 robot.get_observation() 의 키 (bi_omx_follower: left_/right_ + 모터 이름 + .pos, 0~100).
+    """
+    spec = os.environ.get("COUPING_EARLY_STOP", "").strip()
+    if not spec:
+        return None
+    m = re.fullmatch(r"([\w.]+)\s*(>=|<=)\s*(-?[\d.]+)(?::\s*([\d.]+))?(?:@\s*([\d.]+))?", spec)
+    if not m:
+        logging.warning(f"COUPING_EARLY_STOP 형식 오류, 무시함: {spec!r} (예: left_gripper.pos>=90:2@10)")
+        return None
+    return (m.group(1), m.group(2), float(m.group(3)), float(m.group(4) or 2.0), float(m.group(5) or 0.0),
+            os.environ.get("COUPING_EARLY_STOP_DRYRUN", "") not in ("", "0"))
+
+
